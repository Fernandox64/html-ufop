---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import IconCard from '../components/IconCard.astro';
import posGraduacao from '../data/pos-graduacao.json';
---

<BaseLayout title="Pós-Graduação">
  <Breadcrumb title="Pós-Graduação" />
  <section class="section">
    <div class="container">
      <p class="lead-center">{posGraduacao.textoLead}</p>
      <div class="icon-cards-grid cols-2">
        {posGraduacao.programas.map((p) => (
          <IconCard icon={p.icone} title={`${p.nome} (${p.nivel})`} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
